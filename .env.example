# ==========================================
# WonderTeam Environment Variables
# ==========================================

# 1. TEAM_LEADER_EMAIL & TEAM_LEADER_PASSWORD (Recommended)
# The pre-configured account credentials for the Team Leader (Admin role).
# Normal users can only register as 'members'.
# The Team Leader signs in with these credentials and can change their password anytime in Profile.
TEAM_LEADER_EMAIL="leader@wonderteam.com"
TEAM_LEADER_PASSWORD="ChangeMeLeader2026!"
TEAM_LEADER_NAME="Team Leader"

# 2. DATABASE_URL / POSTGRES_URL (Required on Vercel with Neon)
# The PostgreSQL connection string provided by Neon (or Vercel Postgres integration).
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
# If omitted (e.g. local offline dev), the platform falls back to data/db.json.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 3. SESSION_SECRET (Required in production)
# HMAC key used to sign the httpOnly session cookie that authenticates every
# /api request. Must be at least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this signs every user out.
SESSION_SECRET="replace-with-32-plus-random-characters"

# 4. TURSO_DATABASE_URL & TURSO_AUTH_TOKEN (Optional — enables the Chat feature)
# Hosted libSQL/SQLite database holding all chat messages. Chat is deliberately
# kept out of the Neon/Postgres store above so the main database stays small.
# Create a database at https://turso.tech and paste the values here.
# When unset, /api/chat/* returns 503 and the Messages tab is hidden.
TURSO_DATABASE_URL="libsql://your-database-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# 5. VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT (Optional)
# Web Push signing keys used to deliver notifications to members' devices.
# Generate a pair with:
#   npx web-push generate-vapid-keys
# If these are omitted the server generates a pair once and stores it in the
# database, which is fine for local development but means every existing
# device subscription is invalidated if the database is reset.
# VAPID_SUBJECT must be a mailto: or https: URL and is sent to push services.
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:leader@wonderteam.com"

# 6. CRON_SECRET (Required for scheduled reminders)
# Shared secret that Vercel Cron presents as `Authorization: Bearer $CRON_SECRET`
# when calling /api/push/cron/reminders. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the cron endpoint answers 401 and only open-app reminders are sent.
CRON_SECRET="replace-with-32-plus-random-characters"

# Hobby / Free plan note: Vercel allows at most 2 cron jobs on Hobby and only
# triggers them ONCE PER DAY, so vercel.json is scheduled for 08:30 UTC (09:30
# WAT) - the one slot that delivers the morning quote, the clock-in nudge and the
# to-do list warning together. Everything else (budget alerts, overdue tasks,
# attendance nudges) is delivered by the app's own polling while a member has the
# app open. Upgrading to Pro allows the schedule in vercel.json to become hourly.

# 7. GEMINI_API_KEY (Optional but recommended)
# Required for Gemini AI task prioritization and dynamic motivational quote coaching.
# If omitted, the platform uses built-in heuristic IPA algorithms and curated quotes.
GEMINI_API_KEY="your_gemini_api_key_here"

# 8. PORT (Optional, default: 3000)
# Port number for the Express server to listen on.
PORT=3000

# 9. NODE_ENV (Optional, default: development)
# Set to 'production' for live deployment or 'development' for local development.
# In 'production', the server serves pre-built static assets from /dist.
NODE_ENV=production

# 10. APP_URL (Optional)
# The publicly accessible URL where this app is hosted (e.g. https://wonderteam.vercel.app).
APP_URL="http://localhost:3000"

# 11. DISABLE_HMR (Optional, default: false)
# Set to 'true' if running in environments where Vite Hot Module Replacement should be disabled.
DISABLE_HMR=false
