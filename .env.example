# ==========================================
# WonderTeam Environment Variables
# ==========================================

# 1. DATABASE_URL / POSTGRES_URL (Required on Vercel with Neon)
# The PostgreSQL connection string provided by Neon (or Vercel Postgres integration).
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
# If omitted (e.g. local offline dev), the platform falls back to data/db.json.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. GEMINI_API_KEY (Optional but recommended)
# Required for Gemini AI task prioritization and dynamic motivational quote coaching.
# If omitted, the platform uses built-in heuristic IPA algorithms and curated quotes.
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. PORT (Optional, default: 3000)
# Port number for the Express server to listen on.
PORT=3000

# 4. NODE_ENV (Optional, default: development)
# Set to 'production' for live deployment or 'development' for local development.
# In 'production', the server serves pre-built static assets from /dist.
NODE_ENV=production

# 5. APP_URL (Optional)
# The publicly accessible URL where this app is hosted (e.g. https://wonderteam.vercel.app).
APP_URL="http://localhost:3000"

# 6. DISABLE_HMR (Optional, default: false)
# Set to 'true' if running in environments where Vite Hot Module Replacement should be disabled.
DISABLE_HMR=false
